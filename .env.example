# Copy to .env before `docker compose up -d`. Compose reads .env automatically.
#   cp .env.example .env
#
# .env is gitignored — keep the real password here, not in docker-compose.yml.

# Admin account. Created on FIRST BOOT ONLY: once the database exists, changing
# these has no effect (change the password from the dashboard instead).
PROBE_ADMIN_USER=admin

# Leave empty to have the server generate a 16-char password and print it once
# to the container log (`docker compose logs | grep Password`). Logging in with
# a generated password forces a change on first use.
PROBE_ADMIN_PASSWORD=

# Anonymous read-only dashboard. Default false = a login is required for every
# view, including the telemetry itself. Set true to expose a public status page;
# tokens, node config and notification credentials stay behind the login either way.
PROBE_PUBLIC_VIEW=false

# Extra origins allowed to send the session cookie, comma-separated. Needed only
# when the dashboard is served from a different host than the API.
# PROBE_ALLOWED_ORIGINS=https://probe.example.com

# Reverse proxies whose forwarding headers may determine the client IP. Leave
# empty when Probe is exposed directly. Accepts comma-separated IPs or CIDRs.
# Example for a local proxy: PROBE_TRUSTED_PROXIES=127.0.0.1,::1
PROBE_TRUSTED_PROXIES=

# Outbound probe and webhook targets reject private/internal addresses by
# default. Enable only when Probe must reach trusted receivers on your LAN;
# this also permits probe ports outside the public allowlist.
PROBE_ALLOW_PRIVATE_TARGETS=false

# Decides when the daily report's wall-clock time ("09:00") actually fires.
TZ=Asia/Shanghai

# Build-time release version, stamped into the server and the agent it hands out.
# Read only by `docker compose build` — changing it here does nothing until you
# rebuild, and it cannot be defaulted from git because .dockerignore excludes
# .git. Bump it for a release; the dashboard compares each node's reported
# version against this to flag the ones running an older agent.
PROBE_VERSION=dev
