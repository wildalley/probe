[Unit]
Description=Cyber Probe Server Hub (In-Memory Broadcast & SQLite Downsampler)
Documentation=https://github.com/cola/probe
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/probe-server
ExecStart=/usr/local/bin/probe-server --addr ":8080" --db "/var/lib/probe-server/probe.db" --flush-interval 15 --retention-days 7
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
